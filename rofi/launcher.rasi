/* App launcher theme. Colors come from wallust-colors.rasi. */
@import "wallust-colors.rasi"

configuration {
    show-icons:          true;
    display-drun:        "Run";
    drun-display-format: "{name}";
}

* {
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            500px;
    background-color: @bg;
    border:           3px;
    border-color:     @accent;
    border-radius:    10px;
    padding:          15px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  12px;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          8px;
}

prompt {
    text-color: @accent;
}

listview {
    columns:       1;
    lines:         8;
    fixed-columns: true;
    spacing:       4px;
    scrollbar:     false;
}

element {
    orientation:   horizontal;
    padding:       8px;
    spacing:       10px;
    border-radius: 6px;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-alt;
}

element-icon {
    size:           1.6em;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
