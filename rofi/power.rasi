/* Power menu theme. Colors come from wallust-colors.rasi. */
@import "wallust-colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            300px;
    background-color: @bg;
    border:           3px;
    border-color:     @accent;
    border-radius:    10px;
    padding:          15px;
}

mainbox {
    children: [ message, listview ];
    spacing:  12px;
}

message {
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          8px 12px;
}

listview {
    columns:       1;
    lines:         5;
    fixed-columns: true;
    spacing:       4px;
    scrollbar:     false;
}

element {
    padding:       10px 14px;
    border-radius: 6px;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-alt;
}

element-text {
    text-color: inherit;
}
