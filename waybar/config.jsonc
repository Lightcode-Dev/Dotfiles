{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right":  ["pulseaudio", "network", "cpu", "memory", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },

    // \uf017 = clock
    "clock": {
        "format": "\uf017  {:%a %d %b   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // \uf027 = speaker low, \uf028 = speaker high, \uf026 = speaker off
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "\uf026  muted",
        "format-icons": { "default": ["\uf027", "\uf028"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // \uf1eb = wifi, \uf0e8 = network (wired), \uf071 = warning
    "network": {
        "format-wifi": "\uf1eb  {essid}",
        "format-ethernet": "\uf0e8  {ipaddr}",
        "format-disconnected": "\uf071  offline",
        "tooltip-format": "{ifname}"
    },

    // \uf2db = chip, \uf1c0 = database (used for memory)
    "cpu":    { "format": "\uf2db  {usage}%" },
    "memory": { "format": "\uf1c0  {percentage}%" },
    "tray":   { "spacing": 8 },

    // \uf011 = power-off icon; click opens the rofi power menu
    "custom/power": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "$HOME/.config/hypr/moodymoose-scripts/power-menu.sh"
    }
}
